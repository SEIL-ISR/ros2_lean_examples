<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rcllean_example_interfaces</name>
  <version>0.1.0</version>
  <description>
    A message, a service and an action used to exercise the Lean 4 bindings
    generated for an ordinary ROS 2 interface package.
  </description>
  <maintainer email="rmatheu@umd.edu">Ryan Matheu</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <!-- The service and the action pull in these through rosidl; naming
       them keeps colcon from building this package alongside them. -->
  <depend>action_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>service_msgs</depend>
  <depend>std_msgs</depend>
  <depend>unique_identifier_msgs</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
